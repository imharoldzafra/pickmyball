{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile of a player.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 64 },
        "level": { "type": "number" },
        "xp": { "type": "number" },
        "rating": { "type": "number" },
        "rank": { "type": "string", "maxLength": 32 },
        "wins": { "type": "number" },
        "losses": { "type": "number" },
        "battles": { "type": "number" },
        "currentStreak": { "type": "number" },
        "longestStreak": { "type": "number" },
        "highestRating": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "displayName", "level", "xp", "rating", "rank", "wins", "losses", "battles", "currentStreak", "longestStreak", "highestRating", "createdAt"]
    },
    "Match": {
      "title": "Match",
      "description": "A pickleball match.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "creatorId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["WAITING", "READY", "IN_PROGRESS", "FINISHED"] },
        "teamA": { "type": "array", "items": { "type": "string", "maxLength": 128 } },
        "teamB": { "type": "array", "items": { "type": "string", "maxLength": 128 } },
        "refereeId": { "type": "string", "maxLength": 128 },
        "currentGame": { "type": "number" },
        "teamAScore": { "type": "number" },
        "teamBScore": { "type": "number" },
        "teamAGamesWon": { "type": "number" },
        "teamBGamesWon": { "type": "number" },
        "servingTeam": { "type": "string", "enum": ["A", "B", "NONE"] },
        "serverNumber": { "type": "number" },
        "gameResults": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "gameNumber": { "type": "number" },
              "teamAScore": { "type": "number" },
              "teamBScore": { "type": "number" }
            }
          } 
        },
        "matchWinner": { "type": "string", "enum": ["A", "B", "NONE"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "creatorId", "status", "teamA", "teamB", "currentGame", "teamAScore", "teamBScore", "teamAGamesWon", "teamBGamesWon", "servingTeam", "serverNumber", "createdAt", "updatedAt"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "A friend request from one user to another.",
      "type": "object",
      "properties": {
        "fromId": { "type": "string", "maxLength": 128 },
        "toId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["PENDING", "ACCEPTED", "REJECTED"] },
        "createdAt": { "type": "number" }
      },
      "required": ["fromId", "toId", "status", "createdAt"]
    },
    "Friend": {
      "title": "Friend",
      "description": "A friend connection.",
      "type": "object",
      "properties": {
        "friendId": { "type": "string", "maxLength": 128 },
        "addedAt": { "type": "number" }
      },
      "required": ["friendId", "addedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles"
    },
    "/users/{userId}/friends/{friendId}": {
      "schema": { "$ref": "#/entities/Friend" },
      "description": "User's friends"
    },
    "/matches/{matchId}": {
      "schema": { "$ref": "#/entities/Match" },
      "description": "Match sessions"
    },
    "/friendRequests/{requestId}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Friend requests"
    }
  }
}
